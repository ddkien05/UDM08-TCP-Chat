<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Colors -->

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>

    <!-- Surface -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SecondaryBubbleBrush" Color="#F3F4F6"/>

    <!-- States -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EEF0F2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextColor_Primary" Color="#111827"/>
    <SolidColorBrush x:Key="TextColor_Secondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- Disabled -->
    <SolidColorBrush x:Key="DisabledBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9CA3AF"/>

    <!-- Status -->
    <SolidColorBrush x:Key="OnlineStatus" Color="#22C55E"/>
    <SolidColorBrush x:Key="OfflineStatus" Color="#EF4444"/>

    <!-- Font -->

    <FontFamily x:Key="AppFontFamily">
        pack://application:,,,/Assets/Fonts/#Roboto
    </FontFamily>

    <!-- Typography -->

    <!-- Contact name / chat header -->
    <Style x:Key="HeaderMedium"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="16"/>

        <Setter Property="FontWeight"
                Value="Medium"/>

        <Setter Property="LineHeight"
                Value="20"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextColor_Primary}"/>
    </Style>

    <!-- Main message / normal content -->
    <Style x:Key="BodyRegular"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="Normal"/>

        <Setter Property="LineHeight"
                Value="21"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextColor_Primary}"/>
    </Style>

    <!-- Caption -->
    <Style x:Key="Caption"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="12"/>

        <Setter Property="FontWeight"
                Value="Normal"/>

        <Setter Property="LineHeight"
                Value="17"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextColor_Secondary}"/>
    </Style>

    <!-- Placeholder -->
    <Style x:Key="PlaceholderText"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="Normal"/>

        <Setter Property="Foreground"
                Value="{StaticResource PlaceholderBrush}"/>
    </Style>

    <!-- Size tokens -->

    <!-- Layout -->
    <system:Double x:Key="SidebarWidth">280</system:Double>

    <!-- Avatar -->
    <system:Double x:Key="AvatarSize_Sidebar">40</system:Double>
    <system:Double x:Key="AvatarSize_Chat">32</system:Double>

    <!-- Bubble -->
    <system:Double x:Key="BubbleMaxWidth">320</system:Double>

    <CornerRadius x:Key="BubbleCornerRadius">
        12
    </CornerRadius>

    <Thickness x:Key="BubblePadding">
        12,8,12,8
    </Thickness>

    <!-- Input / button -->
    <system:Double x:Key="ChatInputHeight">48</system:Double>

    <CornerRadius x:Key="InputCornerRadius">
        8
    </CornerRadius>

    <CornerRadius x:Key="ButtonCornerRadius">
        8
    </CornerRadius>

    <!-- Contact item -->
    <Thickness x:Key="ContactItemPadding">
        12,10
    </Thickness>

    <system:Double x:Key="ContactAvatarSpacing">
        12
    </system:Double>

    <!-- Chat bubbles -->

    <!-- Self message -->
    <Style x:Key="ChatBubbleSelf"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource PrimaryBrush}"/>

        <Setter Property="TextElement.Foreground"
                Value="{StaticResource TextOnPrimaryBrush}"/>

        <Setter Property="CornerRadius"
                Value="{StaticResource BubbleCornerRadius}"/>

        <Setter Property="Padding"
                Value="{StaticResource BubblePadding}"/>

        <Setter Property="MaxWidth"
                Value="{StaticResource BubbleMaxWidth}"/>

        <Setter Property="HorizontalAlignment"
                Value="Right"/>
    </Style>

    <!-- Other message -->
    <Style x:Key="ChatBubbleOther"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource SecondaryBubbleBrush}"/>

        <Setter Property="TextElement.Foreground"
                Value="{StaticResource TextColor_Primary}"/>

        <Setter Property="CornerRadius"
                Value="{StaticResource BubbleCornerRadius}"/>

        <Setter Property="Padding"
                Value="{StaticResource BubblePadding}"/>

        <Setter Property="MaxWidth"
                Value="{StaticResource BubbleMaxWidth}"/>

        <Setter Property="HorizontalAlignment"
                Value="Left"/>
    </Style>

    <!-- Avatars -->

    <!-- Sidebar avatar -->
    <Style x:Key="ChatAvatar_Sidebar"
           TargetType="Image">

        <Setter Property="Width"
                Value="{StaticResource AvatarSize_Sidebar}"/>

        <Setter Property="Height"
                Value="{StaticResource AvatarSize_Sidebar}"/>

        <Setter Property="Stretch"
                Value="UniformToFill"/>
    </Style>

    <!-- Chat avatar -->
    <Style x:Key="ChatAvatar_Chat"
           TargetType="Image">

        <Setter Property="Width"
                Value="{StaticResource AvatarSize_Chat}"/>

        <Setter Property="Height"
                Value="{StaticResource AvatarSize_Chat}"/>

        <Setter Property="Stretch"
                Value="UniformToFill"/>
    </Style>

    <!-- Chat input -->

    <Style x:Key="ChatInputBox"
           TargetType="TextBox">

        <Setter Property="Height"
                Value="{StaticResource ChatInputHeight}"/>

        <Setter Property="Padding"
                Value="12,0"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderColor}"/>

        <Setter Property="Background"
                Value="{StaticResource BackgroundBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextColor_Primary}"/>

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource InputCornerRadius}">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">

                            <Setter TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource FocusBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="InputBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Send button -->

    <Style x:Key="ChatSendButton"
           TargetType="Button">

        <Setter Property="Background"
                Value="{StaticResource PrimaryBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextOnPrimaryBrush}"/>

        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="Medium"/>

        <Setter Property="Height"
                Value="{StaticResource ChatInputHeight}"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Padding"
                Value="16,0"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryHoverBrush}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryPressedBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{StaticResource DisabledTextBrush}"/>

                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!-- Contact list -->

    <Style x:Key="ContactListItem"
           TargetType="ListBoxItem">

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="Padding"
                Value="{StaticResource ContactItemPadding}"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ListBoxItem">

                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">

                        <Grid>

                            <!-- Selected indicator -->
                            <Border x:Name="SelectedIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="2"/>

                            <ContentPresenter
                                Margin="4,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource HoverBrush}"/>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush}"/>

                            <Setter TargetName="SelectedIndicator"
                                    Property="Background"
                                    Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="Bd"
                                    Property="Opacity"
                                    Value="0.6"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!-- Divider -->

    <Style x:Key="ChatDivider"
           TargetType="Border">

        <Setter Property="Height"
                Value="1"/>

        <Setter Property="Background"
                Value="{StaticResource DividerBrush}"/>

    </Style>

</ResourceDictionary>
