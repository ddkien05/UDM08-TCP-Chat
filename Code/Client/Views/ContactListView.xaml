<UserControl x:Class="Client.Views.ContactListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <Grid Background="#F8FAFC">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="#0A84FF">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- MY AVATAR -->

                <Button Grid.Row="0"
                        Width="56"
                        Height="56"
                        Margin="0,14,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Đổi avatar"
                        Click="ChangeAvatarButton_Click">

                    <Grid Width="54"
                          Height="54">

                        <Ellipse Fill="#DCEEFF"
                                 Stroke="White"
                                 StrokeThickness="2"/>

                        <Border Width="50"
                                Height="50"
                                CornerRadius="25"
                                ClipToBounds="True">

                            <Image x:Name="MyAvatarImage"
                                   Stretch="UniformToFill"/>

                        </Border>

                        <TextBlock x:Name="DefaultAvatarIcon"
                                   Text="👤"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Border Width="18"
                                Height="18"
                                CornerRadius="9"
                                Background="White"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">

                            <Image Source="pack://application:,,,/Assets/Icon/icon_edit.png"
                                   Width="11"
                                   Height="11"/>

                        </Border>

                    </Grid>

                </Button>

                <!-- NAVIGATION -->

                <StackPanel Grid.Row="1"
                            Margin="0,20,0,0"
                            VerticalAlignment="Top">

                    <!-- CHAT -->

                    <Button Width="52"
                            Height="52"
                            Margin="0,4"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Danh sách chat"
                            Click="ChatButton_Click">

                        <Border x:Name="ChatMenuBackground"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                Background="White">

                            <Image Source="pack://application:,,,/Assets/Icon/icon_chat.png"
                                   Width="25"
                                   Height="25"/>

                        </Border>

                    </Button>

                    <!-- CONTACTS -->

                    <Button Width="52"
                            Height="52"
                            Margin="0,4"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Người đang online"
                            Click="ContactsButton_Click">

                        <Border x:Name="ContactsMenuBackground"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                Background="#30FFFFFF">

                            <Image Source="pack://application:,,,/Assets/Icon/icon_contacts.png"
                                   Width="25"
                                   Height="25"/>

                        </Border>

                    </Button>

                </StackPanel>

                <!-- SETTINGS -->

                <Button x:Name="SettingsButton"
                        Grid.Row="2"
                        Width="52"
                        Height="52"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Cài đặt"
                        Click="SettingsButton_Click">

                    <Button.ContextMenu>

                        <ContextMenu Placement="Right">

                            <MenuItem Header="Đăng xuất"
                                      Foreground="#DC2626"
                                      Click="LogoutMenuItem_Click"/>

                        </ContextMenu>

                    </Button.ContextMenu>

                    <Border Width="42"
                            Height="42"
                            CornerRadius="10"
                            Background="#30FFFFFF">

                        <Image Source="pack://application:,,,/Assets/Icon/icon_settings.png"
                               Width="25"
                               Height="25"/>

                    </Border>

                </Button>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- LEFT LIST -->
        <!-- ================================================= -->

        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid Grid.Row="0"
                      Margin="20,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="ListTitleText"
                                   Text="Danh sách chat"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="ListSubtitleText"
                                   Text="Các cuộc trò chuyện gần đây"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#9CA3AF"/>

                    </StackPanel>

                </Grid>

                <!-- SEARCH -->

                <Grid Grid.Row="1"
                      Margin="16,5,16,10">

                    <Border Background="#F3F4F6"
                            CornerRadius="13">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/Assets/Icon/icon_search.png"
                                   Width="18"
                                   Height="18"/>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,0,12,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>

                        </Grid>

                    </Border>

                </Grid>

                <!-- LIST AREA -->

                <Grid Grid.Row="2">

                    <!-- EMPTY -->

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Image x:Name="EmptyIconImage"
                               Source="pack://application:,,,/Assets/Icon/icon_chat.png"
                               Width="55"
                               Height="55"
                               Opacity="0.5"/>

                        <TextBlock x:Name="EmptyMessage"
                                   Text="Chưa có cuộc trò chuyện"
                                   Width="230"
                                   Margin="0,14,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- LIST -->

                    <ListBox x:Name="ChatList"
                             Visibility="Collapsed"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ChatList_SelectionChanged">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding"
                                        Value="0"/>

                                <Setter Property="Margin"
                                        Value="0"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border x:Name="BackgroundBorder"
                                                    Padding="14,10"
                                                    Background="Transparent">

                                                <ContentPresenter/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                         Value="True">

                                                    <Setter TargetName="BackgroundBorder"
                                                            Property="Background"
                                                            Value="#F3F7FC"/>

                                                </Trigger>

                                                <Trigger Property="IsSelected"
                                                         Value="True">

                                                    <Setter TargetName="BackgroundBorder"
                                                            Property="Background"
                                                            Value="#E6F2FF"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid Height="62">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- AVATAR -->

                                    <Grid Grid.Column="0"
                                          Width="48"
                                          Height="48"
                                          VerticalAlignment="Center">

                                        <Ellipse Fill="#DCEEFF"/>

                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="23"
                                                ClipToBounds="True">

                                            <Image Source="{Binding AvatarImage}"
                                                   Stretch="UniformToFill"/>

                                        </Border>

                                        <Ellipse Width="13"
                                                 Height="13"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom">

                                            <Ellipse.Style>

                                                <Style TargetType="Ellipse">

                                                    <Setter Property="Fill"
                                                            Value="#CBD5E1"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsOnline}"
                                                                     Value="True">

                                                            <Setter Property="Fill"
                                                                    Value="#22C55E"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Ellipse.Style>

                                        </Ellipse>

                                    </Grid>

                                    <!-- INFO -->

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="5,0,5,0">

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,2,0,0">

                                            <TextBlock Text="{Binding Username, StringFormat=@{0}}"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"/>

                                            <TextBlock Text=" · "
                                                       Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Foreground"
                                                                Value="#94A3B8"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsOnline}"
                                                                         Value="True">

                                                                <Setter Property="Foreground"
                                                                        Value="#22C55E"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </StackPanel>

                                        <TextBlock Text="{Binding LastMessage}"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                    <!-- TIME -->

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Time}"
                                               Margin="0,8,2,0"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- CHAT HOST -->
        <!-- ================================================= -->

        <Grid Grid.Column="2"
              Background="#F8FAFC">

            <StackPanel x:Name="NoChatSelectedPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border Width="100"
                        Height="100"
                        CornerRadius="50"
                        Background="#EAF4FF">

                    <Image Source="pack://application:,,,/Assets/Icon/icon_chat.png"
                           Width="55"
                           Height="55"/>

                </Border>

                <TextBlock Text="Chọn một cuộc trò chuyện"
                           Margin="0,17,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>

                <TextBlock Text="Chọn một người bên trái để bắt đầu nhắn tin."
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#9CA3AF"/>

            </StackPanel>

            <ContentControl x:Name="ChatContentHost"/>

        </Grid>

    </Grid>

</UserControl>