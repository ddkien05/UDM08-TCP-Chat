<UserControl x:Class="ChatTCP.Client.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500"
             Background="{StaticResource BackgroundBrush}">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="84.8"/>
        </Grid.RowDefinitions>


        <!-- Phần Tiêu đề (Header) -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,16,0">

                <Button x:Name="BackButton"
                        Content="←"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"
                        ToolTip="Quay lại danh sách chat"/>

                <Grid Width="36"
                      Height="36"
                      Margin="0,0,10,0">
                    <Ellipse Fill="#DCEEFF"/>
                    <TextBlock x:Name="ChatTargetInitial"
                               Text="?"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#0A84FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ChatTargetNameText"
                               Text="An Nguyễn"
                               Style="{StaticResource HeaderMedium}"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ChatStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource OnlineStatus}"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="ChatStatusText"
                                   Text="Đang hoạt động"
                                   Style="{StaticResource Caption}"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Khu vực hiển thị tin nhắn -->
        <Grid Grid.Row="1">

            <!-- Trạng thái chưa có tin nhắn nào -->
            <StackPanel x:Name="EmptyChatPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="💬"
                           FontSize="42"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyChatText"
                           Text="Hãy gửi lời chào đầu tiên!"
                           FontSize="14"
                           Foreground="#9CA3AF"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer x:Name="MessageScrollViewer"
                          Padding="16"
                          VerticalScrollBarVisibility="Auto" Margin="0,0,0,1"
                          ScrollChanged="MessageScrollViewer_ScrollChanged">

                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <Border x:Name="MsgBorder"
                                    CornerRadius="12"
                                    Padding="12,8"
                                    MaxWidth="300"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource SecondaryBubbleBrush}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Reply" Click="ReplyMenu_Click"/>
                                            <MenuItem Header="Forward" Click="ForwardMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!-- Bối cảnh tin nhắn trả lời (Reply Context) -->
                                        <Border x:Name="ReplyContextBorder"
                                            Visibility="Collapsed"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="2,0,0,0"
                                            Padding="8,4"
                                            Margin="0,0,0,6">
                                            <TextBlock x:Name="ReplyContextText"
                                                   Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Bối cảnh tin nhắn chuyển tiếp (Forward Context) -->
                                        <Border x:Name="ForwardContextBorder"
                                            Visibility="Collapsed"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="2,0,0,0"
                                            Padding="8,4"
                                            Margin="0,0,0,6">
                                            <TextBlock x:Name="ForwardContextText"
                                                   Text="{Binding ForwardFromName, StringFormat='Chuyển tiếp từ {0}'}"
                                                   Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   FontStyle="Italic"/>
                                        </Border>

                                        <!-- Nội dung chính của tin nhắn -->
                                        <TextBlock x:Name="MsgText" 
                                               Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource BodyRegular}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TimeText"
                                       Text="{Binding LocalTime, StringFormat='HH:mm'}"
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Left"
                                       Margin="4,4,4,0"/>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="MsgBorder" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="MsgBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="MsgText" Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
                                    <Setter TargetName="TimeText" Property="HorizontalAlignment" Value="Right"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsForwarded}" Value="True">
                                    <Setter TargetName="ForwardContextBorder" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Chúng ta có thể dùng trigger để kiểm tra xem tin nhắn có thuộc loại ReplyTo hay không.
                                 Tuy nhiên, do Trigger cơ bản trong WPF khó bắt trường hợp khác NULL, 
                                 nên tốt nhất là ViewModel cung cấp thêm thuộc tính HasReply để Bind thẳng vào Visibility. 
                                 Hiện tại, giữ logic đơn giản ở đây. -->
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <!-- Khu vực nhập tin nhắn -->
        <StackPanel Grid.Row="2" Margin="16,16,16,16">

            <Border x:Name="ReplyPreview"
                    Visibility="Collapsed"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ReplyLabel" Text="Replying to ..." Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ReplySnippet" TextWrapping="Wrap" Style="{StaticResource BodyRegular}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="X" Click="CancelReply_Click" />
                </Grid>
            </Border>

            <Border x:Name="ForwardPreview"
                    Visibility="Collapsed"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ForwardLabel" Text="Forwarding message" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ForwardSnippet" TextWrapping="Wrap" Style="{StaticResource BodyRegular}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="X" Click="CancelForward_Click" />
                </Grid>
            </Border>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Biểu tượng cảm xúc (Emoji) -->
                <Button Grid.Column="0"
                    Content="😀"
                    x:Name="EmojiButton"
                    Width="40"
                    Margin="0,20,8,3"
                    Click="EmojiButton_Click"/>


                <!-- Ô nhập liệu tin nhắn -->
                <TextBox Grid.Column="1"
                     x:Name="MessageInputBox"
                     VerticalContentAlignment="Center"
                     Padding="12,8"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="14" Margin="0,18,0,0"/>


                <!-- Nút gửi tin -->
                <Button Grid.Column="2"
                    Content="Gửi"
                    x:Name="SendButton"
                    Width="70"
                    Margin="8,17,0,3"
                    Style="{StaticResource ChatSendButton}"
                    Click="SendButton_Click"/>

            </Grid>
        </StackPanel>

        <Popup x:Name="EmojiPopup"
               PlacementTarget="{Binding ElementName=EmojiButton}"
               Placement="Top"
               StaysOpen="False"
               Closed="EmojiPopup_Closed">
            <Border Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8">
                <StackPanel Width="300">
                    <TextBox x:Name="EmojiSearchBox"
                             Margin="0,0,0,8"
                             TextChanged="EmojiSearchBox_TextChanged" />
                    <ScrollViewer Height="180">
                        <WrapPanel x:Name="EmojiWrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>

</UserControl>