<UserControl x:Class="ChatTCP.Client.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="700"
             Background="White">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->

                <Grid Grid.Column="0"
                      Width="45"
                      Height="45">

                    <Ellipse Fill="#DCEEFF"/>

                    <Border Width="43"
                            Height="43"
                            CornerRadius="22"
                            ClipToBounds="True">

                        <Image Source="{Binding AvatarImage}"
                               Stretch="UniformToFill"/>

                    </Border>

                    <Ellipse Width="13"
                             Height="13"
                             Stroke="White"
                             StrokeThickness="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom">

                        <Ellipse.Style>

                            <Style TargetType="Ellipse">

                                <Setter Property="Fill"
                                        Value="#CBD5E1"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsOnline}"
                                                 Value="True">

                                        <Setter Property="Fill"
                                                Value="#22C55E"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Ellipse.Style>

                    </Ellipse>

                </Grid>

                <!-- NAME -->

                <StackPanel Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="ChatUserNameText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="ChatUserStatusText"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="#94A3B8"/>

                </StackPanel>

                <!-- ONLINE BADGE -->

                <Border x:Name="OnlineBadge"
                        Grid.Column="2"
                        Padding="10,5"
                        CornerRadius="10"
                        Background="#ECFDF5"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#22C55E"
                                 Margin="0,0,6,0"/>

                        <TextBlock Text="Online"
                                   FontSize="11"
                                   Foreground="#16A34A"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- MESSAGES -->
        <!-- ================================================= -->

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 Padding="20,15"
                 Background="#F8FAFC"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>

                <Style TargetType="ListBoxItem">

                    <Setter Property="Focusable"
                            Value="False"/>

                    <Setter Property="Padding"
                            Value="0"/>

                    <Setter Property="Margin"
                            Value="0,4"/>

                    <Setter Property="BorderThickness"
                            Value="0"/>

                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>

                    <Setter Property="Template">

                        <Setter.Value>

                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>

                        </Setter.Value>

                    </Setter>

                </Style>

            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Grid>

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="HorizontalAlignment"
                                        Value="Left"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsMine}"
                                                 Value="True">

                                        <Setter Property="HorizontalAlignment"
                                                Value="Right"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <!-- REPLY BUTTON LEFT FOR MY MESSAGE -->

                                <Button x:Name="MyReplyButton"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,7,0"
                                        Padding="0"
                                        Visibility="Collapsed"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Trả lời"
                                        Click="ReplyIcon_Click">

                                    <Border Width="29"
                                            Height="29"
                                            CornerRadius="15"
                                            Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">

                                        <Image Source="pack://application:,,,/Assets/Icon/icon_reply.png"
                                               Width="16"
                                               Height="16"/>

                                    </Border>

                                </Button>

                                <!-- BUBBLE -->

                                <Border x:Name="MessageBubble"
                                        Background="#E5E7EB"
                                        CornerRadius="14"
                                        Padding="11"
                                        MaxWidth="350">

                                    <StackPanel>

                                        <!-- REPLY PREVIEW -->

                                        <Border x:Name="ReplyBlock"
                                                Visibility="Collapsed"
                                                Background="#F9FAFB"
                                                BorderBrush="#0A84FF"
                                                BorderThickness="3,0,0,0"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="{Binding ReplySenderName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0A84FF"/>

                                                <TextBlock Text="{Binding ReplyContent}"
                                                           Margin="0,2,0,0"
                                                           MaxWidth="280"
                                                           FontSize="12"
                                                           Foreground="#6B7280"
                                                           TextWrapping="Wrap"/>

                                            </StackPanel>

                                        </Border>

                                        <TextBlock x:Name="MessageText"
                                                   Text="{Binding Content}"
                                                   FontSize="14"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                                <!-- REPLY BUTTON RIGHT FOR OTHER MESSAGE -->

                                <Button x:Name="OtherReplyButton"
                                        Width="32"
                                        Height="32"
                                        Margin="7,0,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Trả lời"
                                        Click="ReplyIcon_Click">

                                    <Border Width="29"
                                            Height="29"
                                            CornerRadius="15"
                                            Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">

                                        <Image Source="pack://application:,,,/Assets/Icon/icon_reply.png"
                                               Width="16"
                                               Height="16"/>

                                    </Border>

                                </Button>

                            </StackPanel>

                            <TextBlock x:Name="MessageTime"
                                       Text="{Binding Time}"
                                       Margin="5,4,5,0"
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Left"/>

                        </StackPanel>

                    </Grid>

                    <DataTemplate.Triggers>

                        <DataTrigger Binding="{Binding HasReply}"
                                     Value="True">

                            <Setter TargetName="ReplyBlock"
                                    Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsMine}"
                                     Value="True">

                            <Setter TargetName="MessageBubble"
                                    Property="Background"
                                    Value="#0A84FF"/>

                            <Setter TargetName="MessageText"
                                    Property="Foreground"
                                    Value="White"/>

                            <Setter TargetName="MessageTime"
                                    Property="HorizontalAlignment"
                                    Value="Right"/>

                            <Setter TargetName="MyReplyButton"
                                    Property="Visibility"
                                    Value="Visible"/>

                            <Setter TargetName="OtherReplyButton"
                                    Property="Visibility"
                                    Value="Collapsed"/>

                        </DataTrigger>

                    </DataTemplate.Triggers>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

        <!-- ================================================= -->
        <!-- INPUT AREA -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

            <Grid Margin="16,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CURRENT REPLY -->

                <Border x:Name="ReplyComposerBorder"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Margin="48,0,60,10"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="#F8FAFC"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="4"
                                CornerRadius="2"
                                Background="#0A84FF"/>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,5,0">

                            <TextBlock x:Name="ReplyComposerSenderText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#0A84FF"/>

                            <TextBlock x:Name="ReplyComposerContentText"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="28"
                                Height="28"
                                Content="×"
                                FontSize="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CancelReplyButton_Click"/>

                    </Grid>

                </Border>

                <!-- INPUT ROW -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- EMOJI -->

                    <Button Grid.Column="0"
                            Width="42"
                            Height="42"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="EmojiButton_Click">

                        <Border Width="37"
                                Height="37"
                                CornerRadius="19"
                                Background="#F3F4F6">

                            <Image Source="pack://application:,,,/Assets/Icon/icon_emoji.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                    </Button>

                    <!-- TEXTBOX -->

                    <Border Grid.Column="1"
                            Height="44"
                            CornerRadius="18"
                            Background="#F3F4F6">

                        <TextBox x:Name="MessageInputBox"
                                 Padding="15,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="MessageInputBox_KeyDown"/>

                    </Border>

                    <!-- SEND -->

                    <Button Grid.Column="2"
                            Width="50"
                            Height="44"
                            Margin="8,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SendButton_Click">

                        <Border Width="46"
                                Height="42"
                                CornerRadius="13"
                                Background="#0A84FF">

                            <Image Source="pack://application:,,,/Assets/Icon/icon_send.png"
                                   Width="24"
                                   Height="24"/>

                        </Border>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>