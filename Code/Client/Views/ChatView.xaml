<UserControl x:Class="ChatTCP.Client.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500"
             Background="White">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->
                <Grid Grid.Column="0"
                      Width="42"
                      Height="42"
                      VerticalAlignment="Center">

                    <Ellipse Fill="#DCEEFF"/>

                    <Ellipse Width="12"
                             Height="12"
                             Stroke="White"
                             StrokeThickness="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom">

                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill"
                                        Value="#EF4444"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}"
                                                 Value="True">
                                        <Setter Property="Fill"
                                                Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>

                    </Ellipse>
                </Grid>

                <!-- NAME + STATUS -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <TextBlock x:Name="ChatUserNameText"
                               Text="Tên người dùng"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="ChatUserStatusText"
                               Text="Ngoại tuyến"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,2,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MESSAGE AREA -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F8FAFC">

            <StackPanel Margin="20">

                <!-- ================= OTHER MESSAGE ================= -->

                <StackPanel Margin="0,6"
                            HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal">

                        <Border Background="#E5E7EB"
                                CornerRadius="12"
                                Padding="12,8"
                                MaxWidth="320"
                                VerticalAlignment="Center">

                            <TextBlock Text="Chào bạn 👋"
                                       FontSize="14"
                                       Foreground="#111827"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button Width="28"
                                Height="28"
                                Margin="6,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Reply"
                                Tag="m1|Trần Minh Anh|Chào bạn 👋"
                                Click="ReplyIcon_Click">

                            <TextBlock Text="↩"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                    </StackPanel>

                    <TextBlock Text="10:15"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Left"
                               Margin="4,4,0,0"/>
                </StackPanel>

                <!-- ================= MY MESSAGE ================= -->

                <StackPanel Margin="0,6"
                            HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="28"
                                Height="28"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Reply"
                                Tag="m2|Bạn|Hello!"
                                Click="ReplyIcon_Click">

                            <TextBlock Text="↩"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Border Background="#0A84FF"
                                CornerRadius="12"
                                Padding="12,8"
                                MaxWidth="320"
                                VerticalAlignment="Center">

                            <TextBlock Text="Hello!"
                                       FontSize="14"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>

                    <TextBlock Text="10:16"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Right"
                               Margin="0,4,4,0"/>
                </StackPanel>

                <!-- ================= REPLY MESSAGE SAMPLE ================= -->

                <StackPanel Margin="0,6"
                            HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal">

                        <Border Background="#E5E7EB"
                                CornerRadius="12"
                                Padding="12,8"
                                MaxWidth="320"
                                VerticalAlignment="Center">

                            <StackPanel>

                                <!-- Reply preview của message đã gửi -->
                                <Border x:Name="ReplyPreviewBorder"
                                        Background="#F9FAFB"
                                        BorderBrush="#0A84FF"
                                        BorderThickness="3,0,0,0"
                                        CornerRadius="4"
                                        Padding="8,5"
                                        Margin="0,0,0,7">

                                    <StackPanel>
                                        <TextBlock x:Name="ReplySenderText"
                                                   Text="Bạn"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0A84FF"/>

                                        <TextBlock x:Name="ReplyContentText"
                                                   Text="Tin nhắn được trả lời"
                                                   FontSize="12"
                                                   Foreground="#6B7280"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Đây là tin nhắn reply."
                                           FontSize="14"
                                           Foreground="#111827"
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>

                        <Button Width="28"
                                Height="28"
                                Margin="6,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Reply"
                                Tag="m3|Trần Minh Anh|Đây là tin nhắn reply."
                                Click="ReplyIcon_Click">

                            <TextBlock Text="↩"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                    </StackPanel>

                    <TextBlock Text="10:20"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Left"
                               Margin="4,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ================================================= -->
        <!-- INPUT AREA -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

            <Grid Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= REPLY COMPOSER PREVIEW ================= -->

                <Border x:Name="ReplyComposerBorder"
                        Grid.Row="0"
                        Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ReplyComposerSenderText"
                                       Text="Người được reply"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#0A84FF"/>

                            <TextBlock x:Name="ReplyComposerContentText"
                                       Text="Nội dung tin nhắn reply"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="26"
                                Height="26"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Huỷ reply"
                                Click="CancelReplyButton_Click">

                            <TextBlock Text="✕"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= INPUT ROW ================= -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- EMOJI -->
                    <Button Grid.Column="0"
                            Width="42"
                            Height="42"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="EmojiButton_Click">

                        <TextBlock Text="😀"
                                   FontSize="21"/>
                    </Button>

                    <!-- MESSAGE INPUT -->
                    <Border Grid.Column="1"
                            Background="#F3F4F6"
                            CornerRadius="15">

                        <TextBox x:Name="MessageInputBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#111827"
                                 Padding="14,10"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <!-- SEND -->
                    <Button Grid.Column="2"
                            Width="70"
                            Height="42"
                            Margin="8,0,0,0"
                            Content="Gửi"
                            Background="#0A84FF"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="SendButton_Click"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>