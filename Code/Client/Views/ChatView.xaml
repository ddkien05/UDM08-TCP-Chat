<UserControl x:Class="ChatTCP.Client.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500"
             Background="{StaticResource BackgroundBrush}">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="84.8"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0">

                <TextBlock Text="An Nguyễn"
                           Style="{StaticResource HeaderMedium}"/>

                <Ellipse Width="8"
                         Height="8"
                         Fill="{StaticResource OnlineStatus}"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Đang hoạt động"
                           Style="{StaticResource Caption}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Message Area -->
        <ScrollViewer Grid.Row="1"
                      Padding="16"
                      VerticalScrollBarVisibility="Auto" Margin="0,0,0,1">

            <StackPanel x:Name="MessageStack">

                <!-- Tin nhắn của người khác -->
                <Border Background="{StaticResource SecondaryBubbleBrush}"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,4"
                        HorizontalAlignment="Left"
                        MaxWidth="300">

                    <TextBlock Text="Chào Phước, khỏe không?"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyRegular}"/>

                </Border>

                <TextBlock Text="10:15"
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Left"
                           Margin="4,0,0,8"/>


                <!-- Tin nhắn của mình -->
                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,4"
                        HorizontalAlignment="Right"
                        MaxWidth="300">

                    <TextBlock Text="Khỏe, cảm ơn bạn! 👋"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyRegular}"
                               Foreground="{StaticResource TextOnPrimaryBrush}"/>

                </Border>

                <TextBlock Text="10:16"
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Right"
                           Margin="0,0,4,8"/>


                <!-- Tin nhắn dạng Reply -->
                <Border Background="{StaticResource SecondaryBubbleBrush}"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,4"
                        HorizontalAlignment="Left"
                        MaxWidth="300">

                    <StackPanel>

                        <Border Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="2,0,0,0"
                                Padding="8,4"
                                Margin="0,0,0,6">

                            <TextBlock Text="Khỏe, cảm ơn bạn! 👋"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <TextBlock Text="Vậy cuối tuần đi cà phê không?"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyRegular}"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="10:20"
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Left"
                           Margin="4,0,0,8"/>

            </StackPanel>

        </ScrollViewer>

        <!-- Message Input -->
        <StackPanel Grid.Row="2" Margin="16,16,16,16">

            <Border x:Name="ReplyPreview"
                    Visibility="Collapsed"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ReplyLabel" Text="Replying to ..." Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ReplySnippet" TextWrapping="Wrap" Style="{StaticResource BodyRegular}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="X" Click="CancelReply_Click" />
                </Grid>
            </Border>

            <Border x:Name="ForwardPreview"
                    Visibility="Collapsed"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ForwardLabel" Text="Forwarding message" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ForwardSnippet" TextWrapping="Wrap" Style="{StaticResource BodyRegular}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="X" Click="CancelForward_Click" />
                </Grid>
            </Border>

            <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- Emoji -->
            <Button Grid.Column="0"
                    Content="😀"
                    x:Name="EmojiButton"
                    Width="40"
                    Margin="0,20,8,3"
                    Click="EmojiButton_Click"/>


            <!-- Message Input -->
            <TextBox Grid.Column="1"
                     x:Name="MessageInputBox"
                     VerticalContentAlignment="Center"
                     Padding="12,8"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="14" Margin="0,18,0,0"/>


            <!-- Send -->
            <Button Grid.Column="2"
                    Content="Gửi"
                    x:Name="SendButton"
                    Width="70"
                    Margin="8,17,0,3"
                    Style="{StaticResource ChatSendButton}"
                    Click="SendButton_Click"/>

            </Grid>
        </StackPanel>

        <Popup x:Name="EmojiPopup"
               PlacementTarget="{Binding ElementName=EmojiButton}"
               Placement="Top"
               StaysOpen="False">
            <Border Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="8">
                <StackPanel Width="300">
                    <TextBox x:Name="EmojiSearchBox"
                             Margin="0,0,0,8"
                             TextChanged="EmojiSearchBox_TextChanged" />
                    <ScrollViewer Height="180">
                        <WrapPanel x:Name="EmojiWrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>

</UserControl>